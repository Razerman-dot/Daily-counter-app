# ---------------------------------------------------------------
# Daily Counter API – environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------

# "development" | "production" | "test"
NODE_ENV=development

# Port the API listens on (Render/Railway inject PORT automatically)
PORT=4000

# MongoDB connection string (MongoDB Atlas free tier works fine)
# e.g. mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/daily-counter?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/daily-counter

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# How long a login lasts (jsonwebtoken format: 7d, 12h, ...)
JWT_EXPIRES_IN=7d

# Exact origin(s) of the frontend allowed by CORS (comma-separated, no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Cookie settings.
#   Same-site setup (frontend proxies /api, or same domain): COOKIE_SAMESITE=lax
#   Cross-site setup (e.g. app.vercel.app -> api.onrender.com): COOKIE_SAMESITE=none (requires HTTPS)
# Defaults: "lax" in development, "none" in production.
COOKIE_SAMESITE=
# Defaults to true in production.
COOKIE_SECURE=

# Default timezone for new users (IANA name)
DEFAULT_TIMEZONE=Africa/Lagos
