# Base URL of the API, WITHOUT the trailing /api.
#
# Leave empty to call the same origin (`/api/...`). That is what you want:
#   - in local dev (Vite proxies /api -> http://localhost:4000), and
#   - in production if you use the Vercel/Netlify rewrite in vercel.json /
#     public/_redirects (recommended: keeps the auth cookie first-party).
#
# Set it only if the browser should call the API directly, cross-site:
#   VITE_API_URL=https://daily-counter-api.onrender.com
VITE_API_URL=

# (dev only) where Vite's proxy forwards /api requests
VITE_DEV_API_TARGET=http://localhost:4000
